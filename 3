import numpy as np

def linear_regression_fit(points):
    X = np.array([p[:-1] for p in points])
    y = np.array([p[-1] for p in points])
    X = np.concatenate((np.ones((X.shape[0], 1)), X), axis=1)
    coefficients = np.linalg.lstsq(X, y, rcond=None)[0]
    return coefficients

def calculate_residual_error(points, coefficients):
    X = np.array([p[:-1] for p in points])
    y = np.array([p[-1] for p in points])
    X = np.concatenate((np.ones((X.shape[0], 1)), X), axis=1)
    y_pred = np.dot(X, coefficients)
    residual_error = np.sum(np.square(y_pred - y))
    return residual_error

sample_points = np.array([[1, 2, 3, 5], [2, 3, 4, 8], [3, 4, 5, 11], [4, 5, 6, 14]])
coefficients = linear_regression_fit(sample_points)
error = calculate_residual_error(sample_points, coefficients)

print("Coefficients:", coefficients)
print("Residual error:", error)
